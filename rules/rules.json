{
  "GST": {
    "required_fields": ["gstin", "business_name", "expiry_date"],
    "rules": [
      {
        "field": "gstin",
        "type": "regex",
        "pattern": "^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$",
        "error": "Invalid GSTIN format"
      },
      {
        "field": "expiry_date",
        "type": "expiry_check",
        "error": "GST certificate has expired"
      },
      {
        "field": "business_name",
        "type": "cross_match",
        "match_against": "PAN.holder_name",
        "error": "Business name does not match PAN"
      }
    ]
  },
  "PAN": {
    "required_fields": ["pan_number", "holder_name"],
    "rules": [
      {
        "field": "pan_number",
        "type": "regex",
        "pattern": "^[A-Z]{5}[0-9]{4}[A-Z]{1}$",
        "error": "Invalid PAN format"
      }
    ]
  },
  "MSME": {
    "required_fields": ["udyam_number", "category", "expiry_date"],
    "rules": [
      {
        "field": "udyam_number",
        "type": "regex",
        "pattern": "^UDYAM-[A-Z]{2}-[0-9]{2}-[0-9]{7}$",
        "error": "Invalid Udyam registration format"
      },
      {
        "field": "expiry_date",
        "type": "expiry_check",
        "error": "MSME certificate has expired"
      }
    ]
  },
  "mandatory_documents": ["GST", "PAN", "MSME"]
}   