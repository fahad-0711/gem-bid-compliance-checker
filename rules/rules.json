{
  "GST": {
    "required_fields": [
      "gstin",
      "business_name"
    ],
    "rules": [
      {
        "field": "gstin",
        "type": "regex",
        "pattern": "^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$",
        "error": "Invalid GSTIN format"
      },
      {
        "field": "expiry_date",
        "type": "expiry_check",
        "error": "GST certificate has expired"
      }
    ]
  },

  "PAN": {
    "required_fields": [
      "pan_number",
      "holder_name"
    ],
    "rules": [
      {
        "field": "pan_number",
        "type": "regex",
        "pattern": "^[A-Z]{5}[0-9]{4}[A-Z]{1}$",
        "error": "Invalid PAN format"
      }
    ]
  },

  "MSME": {
    "required_fields": [
      "udyam_number"
    ],
    "rules": [
      {
        "field": "udyam_number",
        "type": "regex",
        "pattern": "^UDYAM-[A-Z]{2}-[0-9]{2}-[0-9]{7}$",
        "error": "Invalid Udyam registration format"
      }
    ]
  },

  "TURNOVER": {
    "required_fields": [
      "certificate_number",
      "enterprise_name"
    ],
    "rules": [
      {
        "field": "certificate_number",
        "type": "regex",
        "pattern": "^DEMO-TURN-[0-9]{4}$",
        "error": "Invalid turnover certificate number format"
      }
    ]
  },

  "COMPANY_REG": {
    "required_fields": [
      "registration_number",
      "company_name"
    ],
    "rules": [
      {
        "field": "registration_number",
        "type": "regex",
        "pattern": "^SAMPLE-COMP-[0-9]{3}$",
        "error": "Invalid company registration number format"
      }
    ]
  },

  "mandatory_documents": [
    "GST",
    "PAN",
    "MSME",
    "TURNOVER",
    "COMPANY_REG"
  ]
}